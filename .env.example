# LLM API configuration (Groq offers high-speed free-tier access for Llama models)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback / Alternative Providers (optional)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here


# Kaggle credentials (optional if using kagglehub public dataset downloads)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Local cache paths
DATA_DIR=data
RESULTS_DIR=results
